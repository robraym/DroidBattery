<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/batteryVisualCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_battery_card_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingTop="8dp"
    android:paddingEnd="9dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/batteryVisualIcon"
        android:layout_width="64dp"
        android:layout_height="72dp"
        android:layout_marginStart="-8dp"
        android:contentDescription="@string/widget_bateria_visual"
        android:src="@mipmap/ic_widget_battery_app_cutout" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_weight="1">

        <TextView
            android:id="@+id/batteryVisualTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_bateria"
            android:textColor="#FFA7B0C0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/batteryVisualPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="--%"
            android:textColor="#FFF3F6FB"
            android:textSize="31sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/batteryVisualProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_battery_progress" />

    </LinearLayout>

</LinearLayout>
